# Python bytecode and caches
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Virtual environments and packaging
.venv/
venv/
env/
build/
dist/
*.egg-info/

# Editors and operating systems
.idea/
.vscode/
.DS_Store
Thumbs.db

# Local logs and temporary experiment captures
*.log
test_v5.out
v9_run.status
_v5_import*.txt
_v5_smoke*.txt

# Keep only the published benchmark artifacts under results/
results/*
!results/BENCHMARK_REPORT.md
!results/*.png
!results/V9_METRICS.json
!results/V10_METRICS.json
!results/V11_METRICS.json
!results/V13_METRICS.json
